# Cube local dev. Copy to src/cube/.env.
#
# Every value here is a loopback-only placeholder, deliberately committed so any
# developer (or Claude Code, which is blocked from reading dotenv files) can run
# the local validation tooling without handling a real credential. Cube Cloud
# generates its own secrets per deployment — never paste a Cube Cloud value here,
# and never set a local value equal to a production secret.
#
# Full walkthrough: docs/guides/cube.md → "Testing row-level security locally".

# --- Warehouse connection ---
CUBEJS_DB_TYPE=bigquery
CUBEJS_DB_BQ_PROJECT_ID=teamster-332318
CUBEJS_DB_NAME=kipptaf_marts
# CUBEJS_DB_BQ_CREDENTIALS intentionally omitted. Both the driver and
# resolveAccess fall back to ADC while keeping the project pin, so a current ADC
# login is all you need — run the "GCloud: Application Default Login" task if
# your token is stale. A uniform zero rows across EVERY viewer usually means a
# failed identity read, not a policy denial.

# --- Server ---
CUBEJS_DEV_MODE=true
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_TESSERACT_SQL_PLANNER=true
# Signs REST/Playground tokens. Both auth hooks run in dev mode, so the REST
# Playground resolves a pasted {"email": "..."} security context — no
# NODE_ENV=production needed. checkAuth caps token age at 12h from `iat`, so a
# stale cached Playground token denies every view until you re-mint it (clear
# localhost local storage, or re-save the security context).
CUBEJS_API_SECRET=local-dev-secret

# --- SQL API (Postgres wire protocol) ---
# Ground truth for RLS validation: it is the prod BI/Superset path, and identity
# resolves from the SQL user you connect as, so one run covers every viewer
# without a restart:
#   uv run scripts/cube_rls_matrix.py --viewers-file <a local, gitignored file>
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_USER=cube_dev
CUBEJS_SQL_PASSWORD=local-dev-sql

# --- Viewer emulation (#4526) ---
# Emails allowed to resolve ANOTHER viewer's context, via an `act_as` claim on
# the REST surface: {"email": "you@...", "act_as": "a-viewer@..."}. Unset means
# emulation is inert, which is the correct production default. A caller not
# listed here keeps their own scope — act_as is ignored, not refused.
CUBE_IMPERSONATORS=you@apps.teamschools.org
